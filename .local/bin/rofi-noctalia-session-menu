#!/bin/bash

choice=$(
    echo -en '🔒 Lock (1)\n🔚 Logout (2)\n⏸️ Suspend (3)\n🔄 Reboot (4)\n🛑 Shutdown (5)\n' \
        | rofi -dmenu -i -no-custom -p 'session' \
            -kb-custom-1 1 \
            -kb-custom-2 2 \
            -kb-custom-3 3 \
            -kb-custom-4 4 \
            -kb-custom-5 5
)
code=$?

if [[ "${code}" -eq 0 ]]; then
    case "$choice" in
        *Lock*)     code=10 ;;
        *Logout*)   code=11 ;;
        *Suspend*)  code=12 ;;
        *Reboot*)   code=13 ;;
        *Shutdown*) code=14 ;;
    esac
fi

case $code in
    10) noctalia msg session lock ;;
    11) noctalia msg session logout ;;
    12) noctalia msg session suspend ;;
    13) noctalia msg session reboot ;;
    14) noctalia msg session shutdown ;;
esac
